# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All values below are PLACEHOLDERS — replace them.

# ───── Supabase ─────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# ───── Stripe (Connect platform) ─────
# US platform (legacy / back-compat)
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
# Thailand platform (current). Server reads *_TH; the client publishable key
# MUST be the TH platform key (pairs with STRIPE_SECRET_KEY_TH).
STRIPE_SECRET_KEY_TH=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET_TH=whsec_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TH=pk_test_REPLACE

# ───── PayPal ─────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=REPLACE
PAYPAL_CLIENT_SECRET=REPLACE
PAYPAL_MODE=sandbox

# ───── Flash Express ─────
FLASH_EXPRESS_ENV=training
FLASH_EXPRESS_MCH_ID_TRAINING=REPLACE
FLASH_EXPRESS_KEY_TRAINING=REPLACE
FLASH_EXPRESS_MCH_ID_PRODUCTION=REPLACE
FLASH_EXPRESS_KEY_PRODUCTION=REPLACE

# ───── Courier (notifications) ─────
COURIER_AUTH_TOKEN=pk_prod_REPLACE

# ───── Cron + signed-URL secrets ─────
# Distinct secrets! Reuse = compromise of one means compromise of both.
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
LABEL_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING

# ───── Market data APIs ─────
JUSTTCG_API_KEY=REPLACE
RAPIDAPI_KEY=REPLACE

# ───── AI ─────
NEXT_PUBLIC_GEMINI_API_KEY=REPLACE

# ───── Analytics ─────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-REPLACE

# ───── Misc ─────
NEXT_PUBLIC_APP_URL=https://cardstreet.app

# ───── Sentry (server-side, set by Sentry wizard) ─────
SENTRY_ORG=cardstreet
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=REPLACE
