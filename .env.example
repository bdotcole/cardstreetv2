# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All values below are PLACEHOLDERS — replace them.

# ───── Supabase ─────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# ───── Stripe (Connect platform) ─────
# US platform (legacy / back-compat)
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
# Thailand platform (current). Server reads *_TH; the client publishable key
# MUST be the TH platform key (pairs with STRIPE_SECRET_KEY_TH).
STRIPE_SECRET_KEY_TH=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET_TH=whsec_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TH=pk_test_REPLACE

# ───── PayPal ─────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=REPLACE
PAYPAL_CLIENT_SECRET=REPLACE
PAYPAL_MODE=sandbox

# ───── Flash Express ─────
FLASH_EXPRESS_ENV=training
FLASH_EXPRESS_MCH_ID_TRAINING=REPLACE
FLASH_EXPRESS_KEY_TRAINING=REPLACE
FLASH_EXPRESS_MCH_ID_PRODUCTION=REPLACE
FLASH_EXPRESS_KEY_PRODUCTION=REPLACE

# ───── Courier (notifications) ─────
COURIER_AUTH_TOKEN=pk_prod_REPLACE
# Template/event for the one-time "First Time Sale" seller onboarding email.
# Use a Courier template ID, or leave unset to use the event alias `seller_first_sale`.
COURIER_FIRST_TIME_SALE_TEMPLATE_ID=
# Support address shown in transactional emails (defaults to support@thailandtcg.com).
CARDSTREET_SUPPORT_EMAIL=support@thailandtcg.com
# Optional YouTube packaging/shipping guide linked in the first-sale email.
# Leave blank to omit it — the email still sends without it.
YOUTUBE_PACKAGING_GUIDE_URL=
# Internal inbox alerted when a cold-mailed welcome-package partner activates
# their account (defaults to the founder's address if unset).
PARTNER_ACTIVATION_NOTIFY_EMAIL=
# Internal inbox alerted on every new /become-a-breaker application
# (defaults to the founder's address if unset).
BREAKER_APPLICATION_NOTIFY_EMAIL=
# Optional Courier template for the applicant's bilingual confirmation receipt.
# Leave unset to use the inline bilingual copy in lib/courier.ts.
COURIER_BREAKER_CONFIRMATION_TEMPLATE_ID=
# Support tickets (lib/supportEmail.ts). Every new ticket and customer reply is
# emailed here with an English translation (defaults to info@cardstreet.app).
SUPPORT_INBOX_EMAIL=
# Postmark inbound address (Servers -> <server> -> Default Inbound Stream), e.g.
# 451d9b70cf9364d23ff6f9d51d870251569e@inbound.postmarkapp.com. When set, replying
# to a support email posts the reply onto the ticket via the inbound webhook
# https://cardstreet.app/api/webhooks/support-email. When unset, replying to the
# inbox alert emails the customer directly, off the ticket.
SUPPORT_INBOUND_ADDRESS=
# Optional HMAC secret for the signed reply addresses; derived from
# SUPABASE_SERVICE_ROLE_KEY when unset.
SUPPORT_REPLY_SECRET=

# ───── Cron + signed-URL secrets ─────
# Distinct secrets! Reuse = compromise of one means compromise of both.
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
LABEL_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING

# ───── Market data APIs ─────
JUSTTCG_API_KEY=REPLACE
RAPIDAPI_KEY=REPLACE

# ───── AI ─────
NEXT_PUBLIC_GEMINI_API_KEY=REPLACE

# ───── Analytics ─────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-REPLACE
# Meta Pixel / dataset ID (Events Manager). Activates the Pixel in app/layout.tsx
# and the conversion events in lib/metaEvents.ts. Leave unset to disable.
NEXT_PUBLIC_META_PIXEL_ID=REPLACE_WITH_PIXEL_ID

# ───── Misc ─────
NEXT_PUBLIC_APP_URL=https://cardstreet.app

# ───── Sentry (server-side, set by Sentry wizard) ─────
SENTRY_ORG=cardstreet
SENTRY_PROJECT=cardstreet
SENTRY_AUTH_TOKEN=REPLACE

# ── Live-break VOD recording (Cloudflare R2, S3-compatible) ──
# Without these, startRoomRecording SKIPS and shows are never recorded.
# Bucket + token come from Cloudflare > R2 > Manage API Tokens (Object R/W).
LIVEKIT_EGRESS_S3_BUCKET=cardstreet-vods
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
# R2 endpoint is per-account; region is the literal string 'auto'.
LIVEKIT_EGRESS_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
LIVEKIT_EGRESS_S3_REGION=auto
# PUBLIC read host for playback — the r2.dev domain or a custom domain bound
# to the bucket. The endpoint above is credentialed and cannot serve a
# <video> src, so without this a VOD is stored but unwatchable.
LIVEKIT_EGRESS_PUBLIC_BASE_URL=https://pub-<HASH>.r2.dev
