<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links for Deep Linking (Web) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cardstreet.app" />
                <data android:scheme="http" android:host="cardstreet.app" />
            </intent-filter>

            <!-- Custom URL Scheme for Native Auth -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cardstreet" android:host="login-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM default notification appearance. Without an explicit small icon,
             Android falls back to the launcher icon and renders it as a solid
             white square in the status bar. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- Meta (Facebook) SDK. The SDK self-initializes from these values via
             its own merged ContentProvider, so no FacebookSdk.sdkInitialize()
             call is needed. AutoLogAppEvents covers installs/sessions; custom
             conversions (ViewContent/AddToCart/InitiateCheckout/Purchase) arrive
             through the FacebookAppEvents Capacitor plugin (see lib/metaEvents.ts).
             The app id is referenced as a string resource so it is not parsed as
             an integer and truncated. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Used by the Meta (Facebook) SDK for app-event delivery. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Mic for in-app live broadcasting: the console publishes audio, and
         without this the WebView denies the audio leg of getUserMedia, which
         fails the whole capture (camera included). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- RECORD_AUDIO alone is NOT enough. Capacitor's BridgeWebChromeClient
         answers a WebView AUDIO_CAPTURE request by requesting RECORD_AUDIO *and*
         MODIFY_AUDIO_SETTINGS together, and its callback denies the whole
         PermissionRequest unless every permission comes back granted. An
         undeclared normal permission is denied without a prompt, so omitting
         this line silently kills the audio+video getUserMedia — which is what
         versionCode 18 shipped with. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Required on Android 13+ (API 33+) for push notifications to be delivered. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Feature requirements -->

    <!-- RECORD_AUDIO implies android.hardware.microphone with required="true",
         which makes Play hide the app from every mic-less device model. Only
         breakers broadcasting need a mic; buyers, scanners and collectors don't.
         Play flagged 8 devices dropped on the versionCode 18 upload for exactly
         this. Declare it optional and keep asking at runtime instead. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
