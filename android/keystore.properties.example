# Copy this file to android/keystore.properties and fill in real values.
# Keep keystore.properties out of git — it contains your release-signing
# credentials, which can be used to push malicious updates to Google Play
# under your app's identity.
#
# storeFile is relative to the android/ directory (i.e., put the .jks next
# to this file).

storeFile=cardstreet_key.jks
storePassword=REPLACE
keyAlias=cardstreet
keyPassword=REPLACE
