{
    "buildCommand": "next build",
    "installCommand": "npm install",
    "framework": "nextjs",
    "regions": [
        "sin1"
    ],
    "crons": [
        {
            "path": "/api/cron/portfolio-snapshots",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/mirror-images",
            "schedule": "0 4 1 * *"
        },
        {
            "path": "/api/cron/reconcile-shipments",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/live-stream-watchdog",
            "schedule": "15 * * * *"
        },
        {
            "path": "/api/cron/show-reminders",
            "schedule": "*/5 * * * *"
        },
        {
            "path": "/api/cron/pricecharting",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron/price-snapshots",
            "schedule": "30 1 * * *"
        },
        {
            "path": "/api/cron/stripe-setup-nudge",
            "schedule": "0 2 * * *"
        },
        {
            "path": "/api/cron/first-listing-nudge",
            "schedule": "30 2 * * *"
        },
        {
            "path": "/api/cron/expire-offers",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/nudge-accepted-offers",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron/reconcile-pending-orders",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/cron/buyer-payment-nudge",
            "schedule": "*/30 * * * *"
        },
        {
            "path": "/api/cron/recover-unshipped-orders",
            "schedule": "*/30 * * * *"
        },
        {
            "path": "/api/cron/recompute-internal-prices",
            "schedule": "0 2 * * 1"
        },
        {
            "path": "/api/cron/rewards-milestones",
            "schedule": "45 2 * * *"
        },
        {
            "path": "/api/cron/rewards-expiry",
            "schedule": "30 3 1 * *"
        },
        {
            "path": "/api/cron/indexnow-content",
            "schedule": "0 5 * * 1"
        },
        {
            "path": "/api/cron/streak-at-risk",
            "schedule": "0 12 * * *"
        },
        {
            "path": "/api/cron/weekly-digest",
            "schedule": "0 11 * * 5"
        },
        {
            "path": "/api/cron/vault-demand",
            "schedule": "0 12 * * 3"
        },
        {
            "path": "/api/cron/stale-listings",
            "schedule": "0 12 * * 2"
        }
    ]
}
