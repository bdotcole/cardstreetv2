# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit. Any file matching .env* is ignored
# except .env.example (which must contain placeholders only).
.env
.env.*
!.env.example

# Legacy env-handling files that have historically contained real secrets.
# Keep them out of the repo permanently.
VERCEL_ENV_SETUP.txt
fix_env.js
scripts/push_env.js
setup-vercel-env.bat

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.next

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Claude Code worktree state — local-only
.claude/

# Capacitor
android/app/build
ios/App/Pods

# Android signing — never commit. Keystore + credentials live on the
# developer's machine only. See android/keystore.properties.example.
android/keystore.properties
android/*.jks
android/*.keystore
android/app/*.jks
android/app/*.keystore
